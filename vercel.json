{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "routes": [
    { "src": "/api(?:/(.*))?", "dest": "/api" },
    {
      "src": "/projects/(finsight|ai-code-review-agent|factscope-ai)/?",
      "dest": "/projects/$1.html"
    },
    {
      "src": "/(admin|thank-you)/?",
      "dest": "/app.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/404.html", "status": 404 }
  ]
}
