# ==============================================================================
# Hamza Ali AI/ML Portfolio - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values below:
# cp .env.example .env

# --- Google Gemini AI Configuration ---
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Model to use: gemini/gemini-3.1-flash-lite-preview (default), gemini-1.5-flash, gemini-2.0-flash, or gemini-1.5-pro
GEMINI_MODEL=gemini/gemini-3.1-flash-lite-preview

# --- Server Configuration ---
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# --- Database Configuration (MySQL / TiDB) ---
# Format: mysql://user:password@host:port/database
# Leave blank for local offline mode if database is not available.
DATABASE_URL=

# --- Security & Rate Limiting ---
# Rate limits are configured in server/_core/rateLimiter.ts
# Assistant: 15 req / 10 min | Inquiries: 5 req / 15 min

# --- Optional: Error Monitoring & Alerts ---
# Sentry DSN for error tracking in production
SENTRY_DSN=
# Webhook URL (Slack, Discord, or generic) to receive real-time critical error alerts
ERROR_NOTIFICATION_WEBHOOK=

# --- Optional: Frontend Analytics (Umami) ---
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
