# ==============================================================================
# Hamza Ali AI/ML Portfolio - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values below:
# cp .env.example .env

# --- Google Gemini AI Configuration ---
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Model to use: gemini/gemini-3.1-flash-lite-preview (default), gemini-1.5-flash, gemini-2.0-flash, or gemini-1.5-pro
GEMINI_MODEL=gemini/gemini-3.1-flash-lite-preview

# --- Server Configuration ---
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# --- Database Configuration (MySQL / TiDB) ---
# Format: mysql://user:password@host:port/database
# Required for saving legitimate inquiries and assistant follow-ups.
# With no database, the form returns an error and offers direct email.
DATABASE_URL=

# --- Security & Rate Limiting ---
# Rate limits are configured in server/_core/rateLimiter.ts
# Assistant: 15 req / 10 min | Inquiries: 5 req / 15 min

# --- Optional: Notifications & Webhook Alerts ---
# Webhook URL (Discord, Slack, or generic HTTP) to receive instant notifications on new client leads
LEAD_NOTIFICATION_WEBHOOK=
# Sentry DSN for error tracking in production
SENTRY_DSN=
# Webhook URL (Slack, Discord, or generic) to receive real-time critical error alerts
ERROR_NOTIFICATION_WEBHOOK=

# --- Public deployment / search metadata ---
# Set the actual canonical production origin, e.g. https://your-domain.com.
# On Vercel the build can use VERCEL_PROJECT_PRODUCTION_URL automatically.
SITE_URL=
VITE_SITE_URL=

# --- Optional booking ---
# A real HTTPS Calendly event URL; blank uses the direct email fallback.
VITE_CALENDLY_URL=

# --- Optional free measurement ---
# Enable Speed Insights in the Vercel dashboard on a plan with free allowance.
# Both integrations stay off unless explicitly enabled at build time.
VITE_SPEED_INSIGHTS=false
# Enable only after confirming the account's free Web Analytics allowance.
VITE_WEB_ANALYTICS=false

# --- Existing owner authentication ---
# Configure these with the same OAuth provider used by the existing app.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
